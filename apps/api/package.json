{
  "name": "@theonetrust/api",
  "version": "0.0.0",
  "private": true,
  "description": "Theonetrust.in API: donations, payments, receipts, admin. Owns all secrets and DB access.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.json && esbuild src/server.ts --bundle --platform=node --target=node22 --format=esm --external:fastify --external:@fastify/cors --external:@fastify/rate-limit --external:zod --external:@prisma/client --external:@prisma/adapter-pg --external:pg --external:@node-rs/argon2 --external:@fastify/cookie --outfile=dist/server.js",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "test:db": "vitest run --config vitest.db.config.ts",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed": "prisma db seed",
    "owner:set-password": "tsx --env-file-if-exists=../../.env src/cli/set-owner-password.ts",
    "launch:check": "tsx --env-file-if-exists=../../.env src/cli/run-launch-check.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.0",
    "@fastify/rate-limit": "10.3.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@theonetrust/contracts": "workspace:*",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
