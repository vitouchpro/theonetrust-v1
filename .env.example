# Copy to .env and fill locally. NEVER commit real values.
# Backend-only values must never use the VITE_ prefix.

# --- API (backend only) ---
NODE_ENV=development
API_PORT=4000
API_HOST=127.0.0.1
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Neon pooled connection (runtime) and direct connection (migrations). See docs/database-provider-switch.md
DATABASE_URL=
DIRECT_URL=

# Razorpay (test keys only until launch issue #39)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email provider adapter (issue #30)
EMAIL_PROVIDER=
EMAIL_API_KEY=
OWNER_NOTIFICATION_EMAIL=

# --- Web (public, bundled into the browser) ---
VITE_API_BASE_URL=http://localhost:4000/api/v1
